<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fear_bg_primary">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/fear_bg_secondary"
        android:padding="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Back"
            android:textSize="12sp"
            android:backgroundTint="#95a5a6"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trusted Keys"
            android:textColor="@color/fear_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- My identity info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fear_bg_tertiary"
        android:padding="12dp"
        android:layout_marginBottom="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Identity"
            android:textColor="@color/fear_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/myFingerprintTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fear_fingerprint"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/emptyTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No known keys yet. Keys are added automatically when you receive signed messages from other users."
        android:textColor="@color/fear_text_hint"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- Keys list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/keysRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fear_bg_primary"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
