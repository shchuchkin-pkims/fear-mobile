<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка-разделитель между сообщениями разных дней: дата по центру ленты.
  Ширина по содержимому, поэтому плашка обтягивает текст, а не всю строку.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/dateHeaderTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/date_header_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/fear_date_header_text"
        tools:text="5 августа"
        xmlns:tools="http://schemas.android.com/tools" />
</FrameLayout>
