<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fear_bg_primary">

    <!-- Connection Layout -->
    <FrameLayout
        android:id="@+id/connectionLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/connectionMenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:text="☰"
            android:textSize="20sp"
            android:textColor="@color/fear_text_primary"
            android:backgroundTint="@color/fear_btn_menu"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:src="@drawable/logo_white"
            android:contentDescription="F.E.A.R. logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="F.E.A.R."
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/fear_accent"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encrypted Messenger v0.4.2"
            android:textSize="14sp"
            android:textColor="@color/fear_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/fear_accent"
            app:hintTextColor="@color/fear_accent"
            android:textColorHint="@color/fear_accent"
            app:endIconMode="dropdown_menu"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/hostEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Server host"
                android:inputType="text"
                android:textColor="@color/fear_text_primary"
                android:textColorHint="@color/fear_text_hint" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:boxStrokeColor="@color/fear_accent"
                app:hintTextColor="@color/fear_accent"
                android:textColorHint="@color/fear_accent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/portEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Port"
                    android:inputType="number"
                    android:textColor="@color/fear_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:boxStrokeColor="@color/fear_accent"
                app:hintTextColor="@color/fear_accent"
                android:textColorHint="@color/fear_accent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/roomEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Room"
                    android:inputType="text"
                    android:textColor="@color/fear_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/fear_accent"
            app:hintTextColor="@color/fear_accent"
            android:textColorHint="@color/fear_accent"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your name"
                android:inputType="text"
                android:textColor="@color/fear_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxStrokeColor="@color/fear_accent"
            app:hintTextColor="@color/fear_accent"
            android:textColorHint="@color/fear_accent"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/keyEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Room key (optional - leave empty to auto-join)"
                android:inputType="text"
                android:textColor="@color/fear_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Connect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#e94560" />

        <Button
            android:id="@+id/createRoomButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Create Room"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2ecc71" />

        <Button
            android:id="@+id/hostRoomButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Host Room"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/fear_btn_host" />

        <!-- Identity info -->
        <TextView
            android:id="@+id/identityInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fear_text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/generateKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate Identity Key"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/fear_btn_host"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        </LinearLayout>
    </FrameLayout>

    <!-- Chat Layout -->
    <LinearLayout
        android:id="@+id/chatLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top bar: status + online users -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fear_bg_secondary"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/menuButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="☰"
                    android:textSize="20sp"
                    android:textColor="@color/fear_text_primary"
                    android:backgroundTint="@color/fear_btn_menu"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Connected"
                    android:textColor="#2ecc71"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clearChatButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Clear"
                    android:textSize="11sp"
                    android:backgroundTint="#95a5a6"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/onlineUsersTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fear_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/serverStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fear_warning"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/fear_bg_tertiary"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- Input bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/fear_bg_secondary"
            android:padding="8dp">

            <EditText
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Message..."
                android:textColorHint="@color/fear_text_hint"
                android:textColor="@color/fear_text_primary"
                android:background="@color/fear_bg_input"
                android:padding="12dp"
                android:inputType="text"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                android:backgroundTint="#e94560" />
        </LinearLayout>

        <!-- Call controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/fear_bg_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/callButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audio Call"
                android:backgroundTint="#2ecc71"
                android:layout_marginEnd="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/videoCallButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Video Call"
                android:backgroundTint="#3498db"
                android:layout_marginEnd="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/endCallButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="End Call"
                android:backgroundTint="#e74c3c"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/disconnectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnect"
                android:backgroundTint="#95a5a6"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/callStatusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Call in progress..."
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/fear_accent"
            android:background="@color/fear_bg_secondary"
            android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
