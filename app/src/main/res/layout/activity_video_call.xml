<?xml version="1.0" encoding="utf-8"?>
<!--
    A call: one participant large, everyone in a strip along the bottom.

    The big view lives in its own container above the strip rather than
    behind it, so the caption under it has somewhere to sit and the picture
    is not partly covered by the thumbnails.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The area the big view gets, ending where the strip begins. -->
    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="248dp">

        <!--
            TextureView, not SurfaceView.

            A codec fills whatever surface it is given, so the picture has to
            be letterboxed by something. Resizing a SurfaceView to do it
            destroys its surface, and the framework releases the codec bound
            to that surface along with it - measured at 166 decoder rebuilds
            in half a minute. A TextureView letterboxes with a transform
            matrix and never gives its surface up, so nothing is rebuilt. It
            also has no z-order to arrange: several SurfaceViews in one window
            need explicit ordering or all but one are simply covered.
        -->
        <TextureView
            android:id="@+id/remoteSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mainCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="#A0000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Everyone, along the bottom. Tap a cell to keep that person on the
         big view; tap again to let the speaker have it back. -->
    <HorizontalScrollView
        android:id="@+id/stripScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="96dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Local camera preview (corner) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/localPreview"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        app:implementationMode="compatible" />

    <!-- Stats overlay -->
    <TextView
        android:id="@+id/statsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:text="Connecting..." />

    <!-- Controls at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp"
        android:background="#80000000">

        <Button
            android:id="@+id/toggleMuteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mute"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/toggleCameraButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flip"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/endCallButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Call"
            android:backgroundTint="#E74C3C"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</FrameLayout>
